@startuml
title UML 用例图：四类角色的业务边界
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
skinparam backgroundColor #FFFFFF
left to right direction

actor "访客" as Guest
actor "参与者" as P
actor "活动组织者" as O
actor "检票人员" as C
actor "平台管理员" as A

rectangle "活动票务与报名系统" {
  usecase "浏览/组合查询活动" as UC1
  usecase "注册/登录/改密" as UC2
  usecase "报名与模拟支付" as UC3
  usecase "候补/自动递补" as UC4
  usecase "退票/查看电子票" as UC5
  usecase "举报活动" as UC6
  usecase "创建草稿/提交审核" as UC7
  usecase "取消活动/看统计" as UC8
  usecase "审核发布/驳回" as UC9
  usecase "核查举报/下架" as UC10
  usecase "创建检票员账号/限制权限" as UC11
  usecase "选择活动验票签到" as UC12
  usecase "查看/导出名单" as UC13
  usecase "查询操作记录" as UC14
}

Guest --> UC1
P --> UC1
P --> UC2
P --> UC3
P --> UC4
P --> UC5
P --> UC6
O --> UC2
O --> UC7
O --> UC8
O --> UC13
C --> UC2
C --> UC12
C --> UC13
A --> UC2
A --> UC9
A --> UC10
A --> UC11
A --> UC13
A --> UC14

UC3 ..> UC5 : <<出票后可查看>>
UC4 ..> UC3 : <<递补后待支付>>
UC10 ..> UC6 : <<基于举报>>
note right of UC12
  管理员创建检票员账号并线下交付；
  系统暂不设计逐活动授权。
  该简化口径待甲方确认。
end note
@enduml
